{
  "name": "mituweiyuan",
  "description": "迷途未远：基于 Quartz v5 构建的个人数字花园",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "quartz": "node ./quartz/bootstrap-cli.mjs",
    "dev": "node ./quartz/bootstrap-cli.mjs build --serve",
    "build": "node ./quartz/bootstrap-cli.mjs build",
    "docs": "node ./quartz/bootstrap-cli.mjs build --serve -d docs",
    "check": "tsc --noEmit && npx prettier . --check",
    "format": "npx prettier . --write",
    "test": "tsx --test",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1",
    "install-plugins": "node ./quartz/bootstrap-cli.mjs plugin install --from-config --concurrency 4",
    "prebuild": "npm run install-plugins"
  },
  "engines": {
    "npm": ">=11.12.1",
    "node": ">=24.15.0"
  },
  "keywords": [
    "site generator",
    "ssg",
    "digital-garden",
    "markdown",
    "blog",
    "quartz"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@floating-ui/dom": "^1.8.0",
    "@free-fonts/zhuque-fangsong": "^1.0.0",
    "@myriaddreamin/rehype-typst": "^0.7.0",
    "@napi-rs/simple-git": "1.1.0",
    "ansi-truncate": "^1.4.0",
    "async-mutex": "^0.5.0",
    "chokidar": "^5.0.0",
    "esbuild-sass-plugin": "^3.7.0",
    "github-slugger": "^2.0.0",
    "globby": "^16.2.4",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "isomorphic-git": "^1.41.9",
    "lightningcss": "^1.33.0",
    "micromorph": "^0.4.5",
    "minimatch": "^10.1.1",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "pretty-bytes": "^7.1.3",
    "pretty-time": "^1.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rfdc": "^1.4.1",
    "serve-handler": "^6.1.7",
    "sharp": "^0.35.4",
    "source-map-support": "^0.5.21",
    "to-vfile": "^8.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "workerpool": "^10.0.3",
    "ws": "^8.21.3",
    "yaml": "^2.8.2",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@quartz-community/types": "github:quartz-community/types",
    "@quartz-community/utils": "github:quartz-community/utils",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.4.1",
    "@types/pretty-time": "^1.1.5",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.1": true
  }
}
